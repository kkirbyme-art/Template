{
    "extends": [
        "stylelint-config-standard"
    ],
    "rules": {
        "at-rule-no-unknown": [
            true,
            {
                "ignoreAtRules": [
                    "custom-variant",
                    "theme",
                    "apply",
                    "tailwind",
                    "layer"
                ]
            }
        ]
    }
}